# GLM API 配置
GLM_API_KEY=xxxxx
GLM_MODEL=glm-4-flash
GLM_TEMPERATURE=0.3

# ASR 配置
ASR_MODEL_NAME=paraformer-zh
ASR_DEVICE=cpu
FFMPEG_PATH=D:\AI\ffmpeg-8.1.1-essentials_build\bin

# 文件路径配置（相对于项目根目录或使用绝对路径）
UPLOAD_DIR=upload
OUTPUT_DIR=output

# ASR 示例文件路径
ASR_EXAMPLE_AUDIO=asr/example/asr_example.wav
ASR_HOTWORD_FILE=asr/example/hotword.txt
