# GLM API 配置
GLM_API_KEY=xxxxxx
GLM_MODEL=glm-4-flash
GLM_TEMPERATURE=0.3

# 图文速览（与 Markdown 速览并行生成，可不配，使用下列默认值）
# 生成失败时的重试次数（不含 JSON 修复那一次）
VISUAL_SUMMARY_RETRY_MAX=2
# 转写超过该字数时按段生成图文再合并
VISUAL_CHUNK_CHARS=6000
# 分段之间的重叠字数，避免话题在段边界被截断
VISUAL_CHUNK_OVERLAP=400
# 解析 JSON 失败时是否自动调用 LLM 修复（true/false）
VISUAL_JSON_REPAIR=true
# 同时进行的双轨 LLM 总结上限（实时结束 + 批量上传共存时防阻塞）
LLM_SUMMARY_MAX_CONCURRENT=2

# JWT 认证（生产环境请修改密钥）
JWT_SECRET=meeting-ai-jwt-secret-change-in-production
JWT_EXPIRE_HOURS=72

# 通义听悟实时转写（WebSocket 实时会议）
# 在听悟控制台创建项目后获取 AppKey：https://nls-portal.console.aliyun.com/tingwu/projects
ALIBABA_CLOUD_ACCESS_KEY_ID=xxxxxxx
ALIBABA_CLOUD_ACCESS_KEY_SECRET=xxxxxxx
TINGWU_APP_KEY=xxxxxxx
TINGWU_REGION=cn-beijing
TINGWU_DOMAIN=tingwu.cn-beijing.aliyuncs.com
TINGWU_SOURCE_LANGUAGE=cn
TINGWU_AUDIO_FORMAT=pcm
TINGWU_SAMPLE_RATE=16000
# 1=仅完整句；2=句中中间结果+完整句
TINGWU_TRANSCRIPTION_OUTPUT_LEVEL=2
# 说话人分离：true 开启
TINGWU_DIARIZATION_ENABLED=true
# 说话人数：0=自动识别不定人数，2=按两人分离（可设为 0-100）
TINGWU_DIARIZATION_SPEAKER_COUNT=0

# ASR 配置（批量上传转写，非实时）
ASR_MODEL_NAME=paraformer-zh
# 实时 WebSocket 流式转写
ASR_STREAMING_MODEL_NAME=paraformer-zh-streaming
# 语音活动检测（过滤静音幻觉）
ASR_VAD_MODEL_NAME=fsmn-vad
# 能量门限：越小越灵敏，易误识别；越大越不易幻听，可能漏字（建议 0.004~0.015）
ASR_ENERGY_THRESHOLD=0.005
ASR_DEVICE=cpu
FFMPEG_PATH=D:\AI\ffmpeg-8.1.1-essentials_build\bin

# 文件路径配置（相对于项目根目录或使用绝对路径）
UPLOAD_DIR=upload
OUTPUT_DIR=output

# ASR 示例文件路径
ASR_EXAMPLE_AUDIO=asr/example/asr_example.wav
ASR_HOTWORD_FILE=asr/example/hotword.txt

# MySQL 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=xxxxxxx
DB_PASSWORD=xxxxxxx
DB_NAME=meeting_ai
DB_CHARSET=utf8mb4
